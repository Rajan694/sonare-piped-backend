# Copy to .env (never commit it). docker compose reads it, and ./runPiped.sh up and
# ./installPiped.sh copy the PIPED_* settings below into the Piped files (scripts/syncEnvConfig.sh).
# Leave a setting empty to keep what the file already has.

# Postgres password for Piped's own database; changeme if unset (development only).
# Production also needs the same value in config.properties (hibernate.connection.password).
PIPED_DB_PASSWORD=

# Where clients fetch media: Piped rewrites stream and image URLs to this piped-proxy base
# (PROXY_PART in config.properties). It must be reachable from the Sonare backend.
# ./funnel.sh up sets it to the Funnel address (https://<machine>.<tailnet>.ts.net:8443).
PIPED_PROXY_URL=http://localhost:8091

# Publishing Piped through Tailscale Funnel (./funnel.sh), for a backend hosted elsewhere.
# PIPED_KEY: the shared key the gate checks; the backend sends it (PIPED_KEY in its env).
# ./funnel.sh up generates it and sets COMPOSE_PROFILES=funnel, which starts the gate.
PIPED_KEY=
COMPOSE_PROFILES=

# NewPipeExtractor commit Piped is built against (build.gradle). Empty keeps the pin in
# build.gradle; ./runPiped.sh bump updates it here when it is set.
PIPED_EXTRACTOR_COMMIT=
