# The gate Tailscale Funnel publishes (./funnel.sh): Piped and piped-proxy for a Sonare
# backend hosted elsewhere. Only requests carrying the shared key pass; the backend sends it
# as X-Sonare-Key (PIPED_KEY in both .env files). The nginx image fills in ${PIPED_KEY} when
# the container starts.

map $http_x_sonare_key $sonare_key_ok {
    default 0;
    "${PIPED_KEY}" 1;
}

# Piped's API (Funnel :443).
server {
    listen 8092;
    server_tokens off;

    location / {
        # An empty key never passes, even when PIPED_KEY itself is empty.
        if ($http_x_sonare_key = "") { return 403; }
        if ($sonare_key_ok = 0) { return 403; }
        limit_except GET HEAD { deny all; }
        proxy_set_header X-Sonare-Key "";
        proxy_pass http://piped:8080;
        proxy_read_timeout 60s;
    }
}

# piped-proxy, the media the backend relays to listeners (Funnel :8443). Unbuffered, with
# Range passed through, so playback starts at once and seeking works.
server {
    listen 8093;
    server_tokens off;

    location / {
        if ($http_x_sonare_key = "") { return 403; }
        if ($sonare_key_ok = 0) { return 403; }
        limit_except GET HEAD { deny all; }
        proxy_set_header X-Sonare-Key "";
        proxy_pass http://piped-proxy:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
    }
}
